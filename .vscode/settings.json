{
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.editor"
  },
  "files.autoSave": "afterDelay",
  "chat.mcp.autostart": "never",
  "workbench.browser.enableChatTools": false,
  "chat.tools.terminal.autoApprove": {
    "/^npx playwright\\b/": true,
    "/^git (status|branch --show-current|remote -v|log|diff|show|rev-parse|ls-files|check-ignore|fetch)\\b/": true,
    "/^git branch( -vv| -a| -r)?$/": true,
    "/^gh auth status\\b/": true,
    "/^gh pr (list|view)\\b/": true,
    "/^(ls|pwd|cd|test)\\b/": true,
    "/^(printf|echo|jq)\\b[^>]*$/": true
  },
  "search.exclude": {
    "**/solutions/**": true,
    "**/SPOILERS-*.md": true,
    "**/docs/battle/**": true
  },
  "chat.agent.maxRequests": 200
}
