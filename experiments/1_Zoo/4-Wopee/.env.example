# Only needed if you run `wopee-mcp` from a terminal instead of through VS Code.
# Copy to `.env` in the repository root — `.env` is gitignored, and it must stay that way.
#
# Both values come from cmd.wopee.io > your project > Settings.

WOPEE_PROJECT_UUID=
WOPEE_API_KEY=

# Leave this alone unless you are pointed at a different instance.
WOPEE_API_URL=https://api.wopee.io
