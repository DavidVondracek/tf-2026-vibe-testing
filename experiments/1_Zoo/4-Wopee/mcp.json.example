{
  "//": "Copy to ../../../.vscode/mcp.json, then reload VS Code. Copilot Chat picks it up in agent mode.",
  "//2": "The two values are prompted on first use and stored in VS Code's secret storage — they never land in a file in this repo.",
  "servers": {
    "wopee": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "wopee-mcp@latest"],
      "env": {
        "WOPEE_PROJECT_UUID": "${input:wopee_project_uuid}",
        "WOPEE_API_KEY": "${input:wopee_api_key}"
      }
    }
  },
  "inputs": [
    {
      "id": "wopee_project_uuid",
      "type": "promptString",
      "description": "Wopee project UUID (cmd.wopee.io > your project > Settings)"
    },
    {
      "id": "wopee_api_key",
      "type": "promptString",
      "password": true,
      "description": "Wopee project API key (cmd.wopee.io > your project > Settings > API Keys)"
    }
  ]
}
